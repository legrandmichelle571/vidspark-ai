# ============================================
# VidSpark AI Backend - Environment Configuration
# Copy this file to .env and fill in your credentials
# ============================================

# ============================================
# SERVER
# ============================================
NODE_ENV=production
PORT=3001

# ============================================
# DATABASE - SUPABASE
# ============================================
# Get these from: https://supabase.com/dashboard/project/[PROJECT_ID]/settings/api
SUPABASE_URL=https://fnhyskbisfbtjgblbiap.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_key_here

# ============================================
# AUTHENTICATION
# ============================================

# JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_chars
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=604800

# Google OAuth
GOOGLE_CLIENT_ID=665845815325-kguko2tbkji3e9ru9fopmi97qcb9qcvl.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=https://your-production-domain.com/api/auth/google/callback

# ============================================
# PAYMENT - STRIPE
# ============================================
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_PUBLIC_KEY=pk_test_YOUR_PUBLIC_KEY
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_test_YOUR_WEBHOOK_SECRET

# Stripe Price IDs (create these in Stripe Dashboard)
STRIPE_PRICE_PRO=price_pro_monthly
STRIPE_PRICE_BUSINESS=price_business_monthly

# ============================================
# AI SERVICES
# ============================================

# OpenAI
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_KEY

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-YOUR_CLAUDE_KEY

# Google Gemini
GEMINI_API_KEY=YOUR_GEMINI_KEY

# DeepSeek
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_KEY

# ============================================
# FRONTEND URLs
# ============================================
FRONTEND_URL=https://vidsparkpro.com
EXTENSION_ID=your_chrome_extension_id

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_FILE=/var/log/vidspark/backend.log

# ============================================
# REDIS (optional, for caching/queues)
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# EMAIL (optional)
# ============================================
SENDGRID_API_KEY=SG.YOUR_SENDGRID_KEY
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# ============================================
# MONITORING
# ============================================
SENTRY_DSN=https://your_sentry_dsn@sentry.io/PROJECT_ID

# ============================================
# CRON JOBS
# ============================================
CRON_ENABLED=true
RESET_QUOTA_CRON_TIME=0 0 1 * *

# ============================================
# DATABASE SYNC
# ============================================
AUTO_MIGRATE=true
