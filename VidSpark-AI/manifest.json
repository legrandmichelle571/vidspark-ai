{
  "manifest_version": 3,
  "name": "VidSpark AI",
  "version": "9",
  "description": "YouTube SEO Intelligence — AI-powered analysis",
  "permissions": ["storage", "identity"],
  "host_permissions": ["*://*.youtube.com/*", "https://vidsparkpro.com/*", "https://*.vidsparkpro.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "VidSpark AI",
    "default_icon": { "128": "icon.png" }
  },
  "content_scripts": [{
    "matches": ["*://*.youtube.com/*"],
    "js": ["content.js"],
    "css": ["styles.css"],
    "run_at": "document_idle"
  }, {
    "matches": ["https://vidsparkpro.com/*", "https://*.vidsparkpro.com/*"],
    "js": ["website-bridge.js"],
    "run_at": "document_start"
  }],
  "web_accessible_resources": [{
    "resources": ["icon.png"],
    "matches": ["*://*.youtube.com/*"]
  }],
  "icons": { "128": "icon.png" }
}
